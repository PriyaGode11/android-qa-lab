<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Full regression: every test case in the test plan. Runs on main and nightly. -->
<suite name="TaskLab Regression" verbose="1">
    <listeners>
        <listener class-name="com.qalab.tasklab.listeners.FailureArtifactsListener"/>
    </listeners>

    <test name="Regression">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.qalab.tasklab.tests.LoginTests"/>
            <class name="com.qalab.tasklab.tests.TaskManagementTests"/>
            <class name="com.qalab.tasklab.tests.SessionAndLifecycleTests"/>
        </classes>
    </test>
</suite>
