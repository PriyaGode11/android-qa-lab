<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Fast gate for every pull request: the critical path only. -->
<suite name="TaskLab Smoke" verbose="1">
    <listeners>
        <listener class-name="com.qalab.tasklab.listeners.FailureArtifactsListener"/>
    </listeners>

    <test name="Smoke">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.qalab.tasklab.tests.LoginTests"/>
            <class name="com.qalab.tasklab.tests.TaskManagementTests"/>
            <class name="com.qalab.tasklab.tests.SessionAndLifecycleTests"/>
        </classes>
    </test>
</suite>
